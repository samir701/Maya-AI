# ============================================================
# ZETTA Environment Configuration Template (.env.example)
# Canonical safe template for developers - DO NOT commit real secrets here
# ============================================================

ZETTA_ENV=development
ZETTA_DEBUG=true

# Database Settings
ZETTA_DB_PATH=data/database/zetta.db

# Logging Settings
ZETTA_LOG_LEVEL=INFO
ZETTA_LOG_DIR=data/logs

# Security Settings
ZETTA_SANDBOX_ENABLED=true
ZETTA_CONFIRMATION_THRESHOLD=HIGH

# Automation Settings
ZETTA_MAX_STEPS=50

# Legacy / OpenAI Settings
ZETTA_AI_DEFAULT_PROVIDER=demo
ZETTA_AI_MODEL=gpt-4o
ZETTA_AI_BASE_URL=https://api.openai.com/v1
ZETTA_AI_API_KEY=
ZETTA_AI_TIMEOUT=30.0
ZETTA_AI_TEMPERATURE=0.7
ZETTA_AI_MAX_TOKENS=2048
ZETTA_AI_STREAMING=false
ZETTA_AI_MAX_RETRIES=3

# ============================================================
# ZETTA AI EMPLOYEE — PROVIDERS
# ============================================================

AI_PROVIDER=groq
STT_PROVIDER=groq
TTS_PROVIDER=kokoro

# ============================================================
# GROQ (Cloud STT / LLM / TTS Fallback)
# ============================================================

# IMPORTANT: GROQ_API_KEY must be manually supplied by the user in .env (starts with gsk_...)
# NEVER commit a real API key into .env.example or version control!
GROQ_API_KEY=

GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# ============================================================
# KOKORO (Local Neural TTS - CPU Baseline)
# ============================================================

KOKORO_ENABLED=true
KOKORO_DEVICE=cpu
KOKORO_LAZY_LOAD=true
KOKORO_MAX_CONCURRENT_JOBS=1
KOKORO_TIMEOUT_SECONDS=30
KOKORO_MAX_TEXT_CHARS=200
KOKORO_VOICE=af_heart

# ============================================================
# TTS FALLBACK (Kokoro CPU -> Groq Orpheus)
# ============================================================

TTS_FALLBACK_ENABLED=true
TTS_FALLBACK_PROVIDER=groq

# ============================================================
# PRIVACY & AUDIO SETTINGS
# ============================================================

PERSIST_AUDIO=false
